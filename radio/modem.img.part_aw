[QIPCALL:ImsVoiceSuppsConfig]

#This config is required to enable presentation of the call to
#the user when UE is already in two calls (active and held).

#ifndef VENDOR_EDIT
#Johnny.Fu@PSW.NW.MBN 2019/11/19
#Modify for can not receive third call
#presentThirdCalltoUser = 0
#elseif /*VENDOR_EDIT*/

*presentThirdCalltoUser = 1

#endif /*VENDOR_EDIT*/

#This config is required to enable the conference event package
#subscription.
#
#Possible enum values are as follows:
#QPE_IMS_CONF_PCKG_NONE = 0,
#QPE_IMS_CONF_PCKG_ALL = 1,
#QPE_IMS_CONF_PCKG_ORIGINATOR_ONLY = 2,
#QPE_IMS_CONF_PCKG_ORIGINATOR_ONLY_NO_JOIN_IND = 3,
#QPE_IMS_CONF_PCKG_PARTICIPANT_NO_SUBSCRIBE_NO_INDICATION = 4

#ifndef VENDOR_EDIT
#Jianwei.Wang@PSW.NW.MBN.2763421, 2020/01/09
#modify for oppo Volte,Conference call CP should not show Conferece parties list.
#confEvtPakageEnabled = QPE_IMS_CONF_PCKG_ORIGINATOR_ONLY
#elseif /*VENDOR_EDIT*/

*confEvtPakageEnabled = 3

#endif /*VENDOR_EDIT*/

[MEDIA:MediaCommon]

#This config item specifies maximum mtu size for the rtp packet

#ifndef VENDOR_EDIT
#Johnny.Fu@PSW.NW.MBN 2019/11/19
#Change MTU Size to 1300 according to Romania Orange requirements
#mtuSize = 1400
#elseif /*VENDOR_EDIT*/

*mtuSize = 1300

#endif /*VENDOR_EDIT*/

#This config is DL DTMF Mode.
#enum -
#QP_DTMF_PB_NONE = 0,
#QP_DTMF_PB_ADSP = 1,
#QP_DTMF_PB_HLOS = 2,
#QP_DTMF_PB_ADSP_HLOS = 3,
#QP_DTMF_PB_MAX

#ifndef VENDOR_EDIT
#Johnny.Fu@PSW.NW.MBN 2019/11/19
#Modify for can not perform DTMF
#DLDtmfMode = QP_DTMF_PB_HLOS
#elseif /*VENDOR_EDIT*/

*DLDtmfMode = 1

#endif /*VENDOR_EDIT*/

[QIPCALL:ImsMediaProfileConfig]

#This config is required to audio codec profile list.

#ifndef VENDOR_EDIT
#Johnny.Fu@PSW.NW.MBN 2019/11/20
#Change EVS profile according to Romania Orange requirements
#AudioProfile1 = "EVS_0_126;EVS_1_127;AMR_1_104;AMR_0_102"
#elseif /*VENDOR_EDIT*/

*AudioProfile1 = "EVS_1_127;AMR_1_104;AMR_0_102"

#endif /*VENDOR_EDIT*/


