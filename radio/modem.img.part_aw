[QIPCALL:ImsVoiceSuppsConfig]

#This config is required to enable presentation of the call to
#the user when UE is already in two calls (active and held).

#ifndef VENDOR_EDIT
#Tengju.Cui@PSW.NW.MBN,2019/11/19,allow third incoming call when there are two calls .
#presentThirdCalltoUser = 0
#elseif VENDOR_EDIT

*presentThirdCalltoUser = 1

#endif VENDOR_EDIT

#This config is required to enable the conference event package
#subscription.
#
#Possible enum values are as follows:
#QPE_IMS_CONF_PCKG_NONE = 0,
#QPE_IMS_CONF_PCKG_ALL = 1,
#QPE_IMS_CONF_PCKG_ORIGINATOR_ONLY = 2,
#QPE_IMS_CONF_PCKG_ORIGINATOR_ONLY_NO_JOIN_IND = 3,
#QPE_IMS_CONF_PCKG_PARTICIPANT_NO_SUBSCRIBE_NO_INDICATION = 4
#ifndef VENDOR_EDIT
#Zhi.Li@PSW.NW.MBN.1461901 2018/07/04
#Modify for resolve FR Orange Conference call CP show Conference Item issue
#confEvtPakageEnabled = QPE_IMS_CONF_PCKG_ALL
#keen.liu@PSW.NW.MBN.2802935 2020/02/08, Disable conference SUBSCRIBE method as SFR requirement.
#The origial value is 3, so change it to 0 to disable conference SUBSCRIBE method as SFR requirement
#confEvtPakageEnabled = 3
#elseif /*VENDOR_EDIT*/

*confEvtPakageEnabled = 0

#endif /*VENDOR_EDIT*/


[MEDIA:MediaCommon]

#This config item specifies maximum mtu size for the rtp packet
#ifndef VENDOR_EDIT
#Tengju.Cui@PSW.NW.MBN,2019/11/19
#Change MTU Size to 1300 according to FR SFR requirements
#mtuSize = 1400
#elseif VENDOR_EDIT

*mtuSize = 1300

#endif VENDOR_EDIT ␀␀␀
