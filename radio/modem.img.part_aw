#3 --> BandWidth_FB
#4 --> BandWidth_NB_WB
#5 --> BandWidth_NB_SWB
#6 --> BandWidth_NB_FWB
#7 --> BandWidth_MAX

Bandwidth = BandWidth_NB_SWB

#This config is used for hf only

hf_only = 0




[SIPConfig:CustomTimers]

#reliable response retry timer cap in milliseconds

TRelResponseRetry = 0


