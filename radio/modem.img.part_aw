[MEDIA:MediaCommon]

#This config is DL DTMF Mode.
#enum -
#QP_DTMF_PB_NONE = 0,
#QP_DTMF_PB_ADSP = 1,
#QP_DTMF_PB_HLOS = 2,
#QP_DTMF_PB_ADSP_HLOS = 3,
#QP_DTMF_PB_MAX
#ifndef VENDOR_EDIT
#Zhenlong.Liu@PSW.NW.MBN.1901955,2019/04/02
#change for resolve issue of can not play DTMF tone
#DLDtmfMode = QP_DTMF_PB_HLOS
#else /VENDOR_EDIT/

*DLDtmfMode = 1

#endif /VENDOR_EDIT/

[Ut:UtConfiguration]

#This config item controls the Maximum time within which a Response should be sent to UI
#ifndef VENDOR_EDIT
#Li.Yang@NW.MDM.MBN.1619322, 2018/12/18
#Ut server does not respond within 20s, Ue shall fallback to legacy/USSD latest after 2 unsuccessful re-tries and shall use legacy/USSD methods until device is rebooted.
#maxResponseTimerValue = 0
#else /VENDOR_EDIT/

*maxResponseTimerValue = 20

#endif /VENDOR_EDIT/


[QIPCALL:ImsVoiceSuppsConfig]

#This config is required to enable presentation of the call to
#the user when UE is already in two calls (active and held).

#ifndef VENDOR_EDIT
#huangkaihui@PSW.NW.CALL.2267124, 2019-09-02
#presentThirdCalltoUser = 0
#else  /*VENDOR_EDIT*/

*presentThirdCalltoUser = 1

#endif /*VENDOR_EDIT*/


[QIPCALL:ImsVoiceConfig]

#ifndef VENDOR_EDIT
#Jianwei.Wang@PSW.NW.MBN.2031292, 2019/05/20
#modify for oppo SA SIP380 not CSFB issue
#enableAlternateSrvRspCheck = 1
#elseif /*VENDOR_EDIT*/

*enableAlternateSrvRspCheck = 0

#endif /*VENDOR_EDIT*/

